# Same-origin Owner UI and API. Set DOMAIN and COMPOUNDOS_PUBLIC_ORIGIN consistently.
{
    email {$CADDY_EMAIL:admin@localhost}
}
{$DOMAIN:localhost} {
    @backend path /api/* /health /static/* /dashboard /memo/* /learning /settings/*
    reverse_proxy @backend api:8000
    reverse_proxy web:3000
    encode gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
