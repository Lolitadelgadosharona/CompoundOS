# Caddyfile — CompoundOS V1 reverse proxy
# Auto-HTTPS via Let's Encrypt for production domains.
# Edit DOMAIN in .env before deployment.

{
    email {$CADDY_EMAIL:admin@localhost}
}

{$DOMAIN:localhost} {
    reverse_proxy api:8000
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
