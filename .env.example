POSTGRES_USER=compoundos
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=compoundos
DATABASE_URL=postgresql+psycopg://compoundos:local-development-only@127.0.0.1:5432/compoundos
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── AI provider credentials ────────────────────────────────────────────────
# All provider adapters fail closed (raise ConfigurationError) when empty.
# AnthropicAdapter (Claude) — e.g. claude-sonnet-4
ANTHROPIC_API_KEY=
# OpenAIAdapter (GPT) — e.g. gpt-4o
OPENAI_API_KEY=
# GeminiAdapter (Gemini) — NOTE: env var is GOOGLE_API_KEY, not GEMINI_API_KEY
GOOGLE_API_KEY=
# AlphaVantageProvider — market data via Alpha Vantage REST API
AV_API_KEY=

# ── Optional gateway endpoints (ZenMux-compatible) ─────────────────────────
# Leave empty to use the official provider API.
ANTHROPIC_BASE_URL=
# Gateway auth token (Authorization: Bearer) — takes precedence over
# ANTHROPIC_API_KEY. ZenMux issues these as sk-ss-v1-… / sk-ai-v1-… keys.
ANTHROPIC_AUTH_TOKEN=
OPENAI_BASE_URL=
# Reserved: GeminiAdapter does not consume this yet (GEMINI_GATEWAY_SUPPORT_PENDING).
GOOGLE_BASE_URL=

# ── Model aliases ──────────────────────────────────────────────────────────
# Maps canonical internal model names → provider-facing names, applied only
# at the SDK call boundary. Comma-separated canonical=provider pairs.
# e.g. claude-sonnet-4=claude-sonnet-4-6,gpt-4o=openai/gpt-4o
# Leave empty for identity (canonical name is sent verbatim).
COMPOUNDOS_MODEL_ALIASES=
