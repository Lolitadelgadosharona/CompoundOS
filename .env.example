# CompoundOS environment configuration (template).
#
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is gitignored.

# ── Runtime ────────────────────────────────────────────────────────────────
# development | test | production
ENVIRONMENT=production

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=compoundos
# docker-compose.yml reads DB_PASSWORD (maps to POSTGRES_PASSWORD).
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=compoundos
# Required by docker-compose.yml (${DB_PASSWORD:?required}).
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://compoundos:CHANGE_ME@db:5432/compoundos

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Caddy reverse proxy (optional) ─────────────────────────────────────────
# Domain served over HTTPS by the bundled Caddy container.
CADDY_DOMAIN=example.com

# ── AI provider credentials ────────────────────────────────────────────────
# All provider adapters fail closed (raise ConfigurationError) when empty.
# AnthropicAdapter (Claude) — e.g. claude-sonnet-4
ANTHROPIC_API_KEY=
# OpenAIAdapter (GPT) — e.g. gpt-4o
OPENAI_API_KEY=
# GeminiAdapter (Gemini) — NOTE: env var is GOOGLE_API_KEY, not GEMINI_API_KEY
GOOGLE_API_KEY=
# AlphaVantageProvider — market data via Alpha Vantage REST API
AV_API_KEY=

# ── Optional gateway endpoints (ZenMux-compatible) ─────────────────────────
# Leave empty to use the official provider API.
ANTHROPIC_BASE_URL=
# Gateway auth token (Authorization: *** — takes precedence over
# ANTHROPIC_API_KEY. ZenMux issues these as sk-ss-v1-… / sk-ai-v1-… keys.
ANTHROPIC_AUTH_TOKEN=
OPENAI_BASE_URL=
# Reserved: GeminiAdapter does not consume this yet (GEMINI_GATEWAY_SUPPORT_PENDING).
GOOGLE_BASE_URL=

# ── Model aliases ──────────────────────────────────────────────────────────
# Maps canonical internal model names → provider-facing names, applied only
# at the SDK call boundary. Comma-separated canonical=provider pairs.
# e.g. claude-sonnet-4=claude-sonnet-4-6,gpt-4o=openai/gpt-4o
# Leave empty for identity (canonical name is sent verbatim).
COMPOUNDOS_MODEL_ALIASES=

# ── Memo synthesis ─────────────────────────────────────────────────────────
# Output-token cap for the 11-section investment memo synthesis LLM call.
# Default 8000 (the memo can exceed 2000 tokens). Invalid/non-positive values
# fall back to the default.
MEMO_MAX_OUTPUT_TOKENS=8000
