#!/usr/bin/env python3
"""
CompoundOS Safe Autopilot — Supervisor Daemon
Manages the autopilot lifecycle: polls for tasks, spawns workers,
monitors CI, recovers from crashes. Designed to run under launchd.
"""
import json, os, sys, time, subprocess, signal, logging
from datetime import datetime, timezone
from pathlib import Path

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
AUTOPILOT_ROOT = os.path.join(REPO_ROOT, '.autopilot')
PID_FILE = os.path.join(AUTOPILOT_ROOT, 'state', 'supervisor.pid')
LOCK_FILE = os.path.join(AUTOPILOT_ROOT, 'locks', 'supervisor.lock')
LOG_FILE = os.path.join(AUTOPILOT_ROOT, 'logs', 'supervisor.log')

os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(message)s',
    handlers=[
        logging.FileHandler(LOG_FILE),
        logging.StreamHandler(sys.stdout)
    ]
)
log = logging.getLogger('supervisor')

POLL_INTERVAL = 30
BACKOFF_BASE = 60
BACKOFF_MULTIPLIER = 2
MAX_BACKOFF = 900

def write_pid():
    os.makedirs(os.path.dirname(PID_FILE), exist_ok=True)
    with open(PID_FILE, 'w') as f:
        f.write(str(os.getpid()))

def acquire_lock():
    os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
    try:
        fd = os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_RDWR)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
        return True
    except FileExistsError:
        try:
            with open(LOCK_FILE, 'r') as f:
                old_pid = int(f.read().strip())
            try:
                os.kill(old_pid, 0)
                log.warning("Supervisor already running (PID %d)", old_pid)
                return False
            except OSError:
                log.info("Removing stale lock from PID %d", old_pid)
                os.remove(LOCK_FILE)
                return acquire_lock()
        except (ValueError, FileNotFoundError):
            os.remove(LOCK_FILE)
            return acquire_lock()

def release_lock():
    try:
        os.remove(LOCK_FILE)
    except FileNotFoundError:
        pass
    try:
        os.remove(PID_FILE)
    except FileNotFoundError:
        pass

def has_queued_tasks():
    queued_dir = os.path.join(AUTOPILOT_ROOT, 'queue', 'queued')
    if not os.path.isdir(queued_dir):
        return False
    return len([f for f in os.listdir(queued_dir) if f.endswith('.json')]) > 0

def spawn_worker():
    worker_script = os.path.join(REPO_ROOT, 'scripts', 'autopilot-worker')
    if not os.path.isfile(worker_script):
        log.error("Worker script not found: %s", worker_script)
        return None
    try:
        proc = subprocess.Popen(
            [sys.executable, worker_script],
            cwd=REPO_ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        log.info("Spawned worker PID %d", proc.pid)
        return proc
    except Exception as e:
        log.error("Failed to spawn worker: %s", e)
        return None

def check_ci_status():
    """Check GitHub Actions CI status for the latest commit on main."""
    try:
        result = subprocess.run(
            ['gh', 'run', 'list', '--branch', 'main', '--limit', '1', '--json', 'status,conclusion'],
            cwd=REPO_ROOT, capture_output=True, text=True, timeout=30
        )
        if result.returncode != 0:
            return None
        data = json.loads(result.stdout)
        if data:
            run = data[0]
            return {'status': run.get('status'), 'conclusion': run.get('conclusion')}
    except Exception as e:
        log.warning("CI check failed: %s", e)
    return None

def git_fetch_origin():
    try:
        subprocess.run(['git', 'fetch', 'origin', 'main'],
                      cwd=REPO_ROOT, capture_output=True, timeout=60)
    except Exception as e:
        log.warning("Git fetch failed: %s", e)

def verify_untracked_files():
    """Verify that protected untracked files haven't changed."""
    manifest_path = os.path.join(AUTOPILOT_ROOT, 'state', 'untracked_manifest.json')
    if not os.path.isfile(manifest_path):
        return True  # No manifest, nothing to verify
    
    try:
        with open(manifest_path) as f:
            manifest = json.load(f)
    except Exception:
        return True
    
    all_ok = True
    for entry in manifest.get('files', []):
        fpath = os.path.join(REPO_ROOT, entry['path'])
        if not os.path.isfile(fpath):
            log.warning("Untracked file missing: %s", entry['path'])
            all_ok = False
            continue
        actual_size = os.path.getsize(fpath)
        if actual_size != entry['size_bytes']:
            log.warning("Untracked file size changed: %s (expected %d, got %d)",
                       entry['path'], entry['size_bytes'], actual_size)
            all_ok = False
    
    if not all_ok:
        log.error("Protected untracked files have been modified!")
    return all_ok

def run_loop():
    consecutive_failures = 0
    
    while True:
        try:
            # Verify untracked file integrity
            if not verify_untracked_files():
                log.critical("Untracked file integrity check failed — supervisor pausing")
                time.sleep(300)
                continue
            
            # Fetch origin to stay current
            git_fetch_origin()
            
            # Check CI
            ci = check_ci_status()
            if ci:
                log.info("CI status: %s (conclusion: %s)", ci['status'], ci['conclusion'])
            
            # Process queued tasks
            if has_queued_tasks():
                log.info("Queued tasks found, spawning worker...")
                worker = spawn_worker()
                if worker:
                    try:
                        worker.wait(timeout=600)
                        log.info("Worker exited with code %d", worker.returncode)
                    except subprocess.TimeoutExpired:
                        log.warning("Worker timeout — terminating")
                        worker.kill()
                        worker.wait()
                
                # Reset backoff on activity
                consecutive_failures = 0
            
            # Check for blocked tasks that might need attention
            blocked_dir = os.path.join(AUTOPILOT_ROOT, 'queue', 'blocked')
            if os.path.isdir(blocked_dir):
                blocked = [f for f in os.listdir(blocked_dir) if f.endswith('.json')]
                if blocked:
                    log.info("Blocked tasks: %d", len(blocked))
            
            # Wait before next poll
            time.sleep(POLL_INTERVAL)
            
        except KeyboardInterrupt:
            log.info("Shutdown requested")
            break
        except Exception as e:
            consecutive_failures += 1
            backoff = min(BACKOFF_BASE * (BACKOFF_MULTIPLIER ** consecutive_failures), MAX_BACKOFF)
            log.error("Loop error (failure #%d, backoff %ds): %s", consecutive_failures, backoff, e)
            time.sleep(backoff)

def main():
    if not acquire_lock():
        log.error("Could not acquire supervisor lock — exiting")
        sys.exit(1)
    
    write_pid()
    log.info("Supervisor started (PID %d)", os.getpid())
    log.info("Repository: %s", REPO_ROOT)
    log.info("Poll interval: %ds", POLL_INTERVAL)
    
    try:
        run_loop()
    finally:
        release_lock()
        log.info("Supervisor stopped")

if __name__ == '__main__':
    main()
