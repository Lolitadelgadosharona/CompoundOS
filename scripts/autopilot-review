#!/usr/bin/env python3
"""
CompoundOS Safe Autopilot — Blind Reviewer
Performs independent code review using a separate Hermes session.
Used when Codex is unavailable or circuit breaker is open.
"""
import json, os, sys, subprocess, tempfile, re
from datetime import datetime, timezone

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
AUTOPILOT_ROOT = os.path.join(REPO_ROOT, '.autopilot')

def build_review_prompt(task, diff_content):
    """Build a review prompt that focuses only on requirements, code, diff, and test results."""
    lines = [
        "You are an independent code reviewer for the CompoundOS Safe Autopilot.",
        "Review the following task implementation against its requirements.",
        "",
        f"TASK: {task.get('task_id')} — {task.get('title')}",
        f"SPRINT: {task.get('sprint')}",
        f"SLICE: {task.get('slice')}",
        f"RISK LEVEL: {task.get('risk_level')}",
        "",
        "REQUIREMENTS:",
    ]
    for req in task.get('requirements', []):
        lines.append(f"  - {req}")

    lines.append("")
    lines.append("ALLOWED PATHS:")
    for p in task.get('allowed_paths', []):
        lines.append(f"  - {p}")

    lines.append("")
    lines.append("FORBIDDEN SCOPE:")
    for f in task.get('forbidden_scope', []):
        lines.append(f"  - {f}")

    lines.append("")
    lines.append("ACCEPTANCE CRITERIA:")
    for ac in task.get('acceptance_criteria', []):
        lines.append(f"  - {ac}")

    lines.append("")
    lines.append("CODE DIFF:")
    lines.append("```")
    lines.append(diff_content[:20000])
    lines.append("```")

    lines.append("")
    lines.append("Review for:")
    lines.append("1. Does the implementation satisfy all requirements?")
    lines.append("2. Does it stay within allowed_paths?")
    lines.append("3. Does it avoid all forbidden_scope items?")
    lines.append("4. Does it meet all acceptance criteria?")
    lines.append("5. Are there any security concerns, secret leaks, or scope violations?")
    lines.append("")
    lines.append("Respond with:")
    lines.append("- VERDICT: APPROVE / REQUEST_CHANGES / BLOCKED")
    lines.append("- FINDINGS: list of BLOCKER, HIGH, MEDIUM, LOW findings")
    lines.append("- SUMMARY: one-sentence summary")

    return '\n'.join(lines)

def review_task(task_file, diff_file=None):
    """Perform blind review of a task implementation."""
    with open(task_file, 'r') as f:
        task = json.load(f)

    # Get diff content
    if diff_file and os.path.isfile(diff_file):
        with open(diff_file, 'r') as f:
            diff_content = f.read()
    else:
        # Generate diff from worktree
        safe_id = task['task_id'].lower().replace('-', '_')
        wt_path = os.path.join(AUTOPILOT_ROOT, 'worktrees', safe_id)
        if os.path.isdir(wt_path):
            result = subprocess.run(
                ['git', '-C', wt_path, 'diff', 'HEAD'],
                capture_output=True, text=True, timeout=30
            )
            diff_content = result.stdout
        else:
            diff_content = "(no worktree or diff available)"

    prompt = build_review_prompt(task, diff_content)

    log_dir = os.path.join(AUTOPILOT_ROOT, 'logs', 'reviews')
    os.makedirs(log_dir, exist_ok=True)

    log_file = os.path.join(log_dir, f"{task['task_id']}_{datetime.now(timezone.utc).strftime('%Y%m%d_%H%M%S')}.txt")

    try:
        result = subprocess.run(
            ['hermes', 'chat', '-q', prompt],
            cwd=REPO_ROOT,
            capture_output=True, text=True, timeout=600
        )

        review_output = result.stdout

        # Structural verdict parsing — expects "VERDICT: <value>" on its own line
        verdict = "UNKNOWN"
        verdict_match = re.search(
            r'^\s*VERDICT\s*:\s*(APPROVE|REQUEST_CHANGES|BLOCKED)\s*$',
            review_output, re.MULTILINE | re.IGNORECASE
        )
        if verdict_match:
            raw_verdict = verdict_match.group(1).upper()
            if raw_verdict == 'APPROVE':
                verdict = 'APPROVE'
            elif raw_verdict in ('REQUEST_CHANGES', 'REQUEST CHANGES'):
                verdict = 'REQUEST_CHANGES'
            elif raw_verdict == 'BLOCKED':
                verdict = 'BLOCKED'

        # Also parse findings severity
        findings = []
        for m in re.finditer(
            r'-\s*(BLOCKER|HIGH|MEDIUM|LOW|NON-BLOCKING)\s*[:\-]\s*(.+)',
            review_output, re.IGNORECASE
        ):
            findings.append({
                'severity': m.group(1).upper(),
                'description': m.group(2).strip()
            })

        # Save review
        review = {
            'task_id': task['task_id'],
            'timestamp': datetime.now(timezone.utc).isoformat(),
            'verdict': verdict,
            'full_output': review_output,
            'reviewer': 'hermes-blind-review',
            'exit_code': result.returncode
        }

        with open(log_file, 'w') as f:
            f.write(review_output)

        return review

    except subprocess.TimeoutExpired:
        return {
            'task_id': task['task_id'],
            'verdict': 'TIMEOUT',
            'error': 'Review timed out after 10 minutes',
            'reviewer': 'hermes-blind-review'
        }
    except Exception as e:
        return {
            'task_id': task['task_id'],
            'verdict': 'ERROR',
            'error': str(e),
            'reviewer': 'hermes-blind-review'
        }

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: autopilot-review <task-file> [diff-file]")
        sys.exit(1)

    task_file = sys.argv[1]
    diff_file = sys.argv[2] if len(sys.argv) > 2 else None

    review = review_task(task_file, diff_file)
    print(json.dumps(review, indent=2))
