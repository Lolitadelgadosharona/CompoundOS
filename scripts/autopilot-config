#!/usr/bin/env python3
"""Parse autopilot YAML config and emit values."""
import sys, os

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML not installed. Run: pip3 install pyyaml", file=sys.stderr)
    sys.exit(1)

def get_config(key, config_path=None):
    if config_path is None:
        repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        config_path = os.path.join(repo, '.autopilot', 'config', 'autopilot.yaml')
    
    with open(config_path, 'r') as f:
        cfg = yaml.safe_load(f)
    
    parts = key.split('.')
    val = cfg
    for p in parts:
        val = val.get(p, {})
    return val

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: autopilot-config <key>", file=sys.stderr)
        sys.exit(1)
    
    val = get_config(sys.argv[1])
    if isinstance(val, (dict, list)):
        import json
        print(json.dumps(val))
    else:
        print(val)
