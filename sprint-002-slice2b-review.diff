+            "policy_id": uuid4(),
+            "version_number": 1,
+            "status": "published",
+            "objectives": "Owner goal",
+            "time_horizon": "Long term",
+            "liquidity": "",
+            "diversification": "",
+            "contribution_policy": "",
+            "rebalancing_policy": "",
+            "prohibited_assets": "",
+            "leverage_policy": "",
+            "decision_process": "Owner process",
+            "notes": "",
