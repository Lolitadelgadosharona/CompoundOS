+def test_application_never_calls_create_all() -> None:
+    application_files = sorted(Path("apps").rglob("*.py"))
+    offenders = [
+        str(path)
+        for path in application_files
+        if ".create_all(" in path.read_text(encoding="utf-8")
+    ]
+    assert offenders == []
